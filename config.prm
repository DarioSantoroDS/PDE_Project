subsection Geometry
  set Number of cells per edge        = 8
  set Stokes degree = 2
  set Elasticity degree = 1
  set Fluid weight        = 100
  set Solid weight        = 10
end

subsection Refinement
  set Refinement cycles = 2
end

subsection Physics
  set Viscosity = 1.0
  set mu = 1.0
  set lambda = 1.0
end